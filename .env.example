# Database
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber
POSTGRES_DB=barbershop
DATABASE_URL=postgres://barber:barber@db:5432/barbershop?schema=public
# Для локального запуска без docker (npm run dev вне контейнера):
# DATABASE_URL=postgres://barber:barber@localhost:5432/barbershop?schema=public

# App
APP_PORT=3000
DB_PORT=5432
NEXTAUTH_SECRET=change-me-to-random-32-chars
NEXTAUTH_URL=http://localhost:3000

# Bot
BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
# Muse Spark / OpenAI совместимый
AI_API_KEY=PUT_YOUR_AI_API_KEY_HERE
AI_BASE_URL=https://api.muse spark.example/v1
AI_MODEL=muse-spark-1.2

# Knowledge fallback (если БД пустая)
BARBERSHOP_ADDRESS=д. Примерово, ул. Центральная 1
BARBERSHOP_PHONE=+7 900 000-00-00
BARBERSHOP_HOURS=Ежедневно 09:00-19:00
